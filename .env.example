AUTH_PASSWORD_RESET_REDIRECT_TO=

# Waitlist confirm links (optional; default to <site origin> and 48 hours)
WAITLIST_CONFIRM_BASE_URL=
WAITLIST_CONFIRM_EXP_HOURS=
